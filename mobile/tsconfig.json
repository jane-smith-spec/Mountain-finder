{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // The same discipline the root tsconfig sets, for the same reason: this
    // app reads sensor arrays and pixel indices, which is exactly where an
    // unchecked index quietly produces a plausible wrong number.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/live/**/*.ts", "../src/core/**/*.ts"],
  // Test files are excluded, and not for tidiness. They import `vitest` and
  // `fixtures/`, which live in the ROOT install — so including them made this
  // typecheck silently depend on `npm install` having been run at the
  // repository root as well. That is false everywhere it matters: a fresh
  // clone, a Codespace, and the CI job all install only `mobile/`, and the
  // app bundles perfectly well without the root (verified: 750 modules, no
  // root node_modules present). The tests are typechecked by the root's own
  // `npm run typecheck`, which is where they belong.
  "exclude": ["node_modules", "../src/**/*.test.ts"]
}
