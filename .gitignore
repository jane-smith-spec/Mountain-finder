node_modules/
dist/
out/
coverage/
test-results/
playwright-report/

.env
.env.*

.DS_Store
.vscode/
.idea/

# Downloaded topo tiles — large binaries, fetched via npm run fetch:tiles
data/tiles/*.hgt
data/tiles/*.hgt.gz

# Overture parquet footers cached by npm run fetch:peaks
data/overture/

# Agent scratch space — never committed
scratch/

# Expo dev-server + build caches
mobile/.expo/

# Expo prebuild output. `npx expo run:ios` generates these native projects from
# app.json; they are build artefacts, not sources, and regenerate on demand.
mobile/ios/
mobile/android/
